# ==============================================================================
# Feedback Intelligence System - Environment Configuration Template
# NOTE: Do NOT store real secrets or API keys in this file.
# Copy this file to .env and replace placeholder values with your real configuration.
# ==============================================================================

# Application & ASGI Server Settings
ENVIRONMENT=development
DEBUG=False
PROJECT_NAME="Feedback Intelligence System"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication (BACKEND ONLY - NEVER EXPOSE TO CLIENT)
# In production, generate a secure 64-char key using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=15

# Initial Bootstrap Administrator (Optional: seeded on first boot if no admin exists)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_admin_password_in_env

# CORS Configuration (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","https://your-frontend-domain.com"]

# PostgreSQL Database Configuration
# Supports standard managed PostgreSQL services (Render, Railway, Supabase, Neon, AWS RDS)
# Note: psycopg2 dialect will automatically be used if postgres:// or postgresql:// is provided
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/feedback_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=feedback_db
POSTGRES_PORT=5432

# Redis & Celery Background Processing
# Managed Redis URL (e.g. redis://default:pass@redis-host:6379/0 or rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
LOG_LEVEL=INFO

# AI/ML Intelligence Layer Configuration
SENTIMENT_MODEL=baseline
ENABLE_ADVANCED_NLP=False
CLASSIFICATION_THRESHOLD=0.3

# Optional OpenAI Integration (App runs baseline heuristic ML if empty - zero cost required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Frontend Client Configuration (PUBLIC - BUNDLED INTO FRONTEND STATIC ASSETS)
# ==============================================================================
# If served via Docker Nginx reverse-proxy on the same domain, leave empty: ""
# If hosted on a separate domain (e.g. Vercel/Netlify), set to backend API base URL:
VITE_API_BASE_URL=http://localhost:8000/api/v1
